  "authors": [
    "jomairofx"
  ],
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "nl.kempenaar.Kempenaar"
    ],
    "client": [
      "nl.kempenaar.client.KempenaarClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "mixins": [
    "kempenaar.mixins.json",
    {
      "config": "kempenaar.client.mixins.json",
      "environment": "client"
    }
  ],
  "icon": "assets/kempenaar/icon.png"
